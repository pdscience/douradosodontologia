---
import '../styles/global.css';
interface Props {
  title?: string;
}

const { title = 'Dourados Odontologia | Odontologia de excelência, personalizada para você' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Dourados Odontologia — odontologia de excelência, personalizada para você. Excelência em cada detalhe. Cuidado em cada sorriso." />
  <title>{title}</title>
  <slot name="head" />
</head>
<body>
  <slot name="body" />
</body>
</html>
